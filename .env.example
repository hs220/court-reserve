CR_EMAIL=your@email.com
CR_PASSWORD=yourpassword

# Email failure notifications (optional)
# For Gmail, generate an App Password at https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=your@email.com
SMTP_PASSWORD=your-app-password
# SMTP_HOST=smtp.gmail.com   # default
# SMTP_PORT=587              # default
# SMTP_USER=your@email.com   # defaults to NOTIFY_EMAIL
# WEB_BASE_URL=http://192.168.68.70:7000   # makes failure emails link to the run log

# GitHub auto-file for web UI bug reports (optional)
# Fine-grained PAT with "Issues: read & write" on the target repo.
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=hs220/court-reserve   # default

# Home agent API (/api/agent/v1, optional). The SHA-256 of the agent's bearer token;
# make one with `python scripts/mint_agent_token.py`. Unset = the API answers 503.
# AGENT_API_TOKEN_SHA256=
